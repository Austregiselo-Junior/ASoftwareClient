<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ASoftware_Client.Views.Patients"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ASoftware_Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="using:ASoftware_Client.ViewModel"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ItemsPanelTemplate x:Key="PanelItensTemplate">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="PatientsDataTemplate" x:DataType="viewModel:PatientsViewModel">
                <RelativePanel RelativePanel.AlignHorizontalCenterWithPanel="True" RelativePanel.AlignVerticalCenterWithPanel="True">

                    <TextBlock
                        x:Name="Patients"
                        Margin="0,5,65,0"
                        IsTapEnabled="False"
                        Text="Teste" />
                    <TextBlock
                        x:Name="Cells"
                        Margin="0,5,65,0"
                        IsTapEnabled="False"
                        RelativePanel.RightOf="Patients"
                        Text="Teste" />
                    <TextBlock
                        x:Name="DateOfConsults"
                        Margin="0,5,95,0"
                        IsTapEnabled="False"
                        RelativePanel.RightOf="Cells"
                        Text="Teste" />

                    <Button
                        x:Name="AddPatient"
                        Margin="0,0,10,0"
                        Background="Green"
                        Click="AdicionarCliente_Click"
                        Content="Adicionar Novo Paciente"
                        RelativePanel.RightOf="DateOfConsults" />
                    <Button
                        x:Name="EditPatient"
                        Margin="0,0,10,0"
                        Background="Yellow"
                        Click="EditCliente_Click"
                        Content="Editar Paciente"
                        RelativePanel.RightOf="AddPatient" />
                    <Button
                        x:Name="DeletePatient"
                        Margin="0,0,10,0"
                        Background="Red"
                        Click="DeleteCliente_Click"
                        Content="Excluir Paciente"
                        RelativePanel.RightOf="EditPatient" />
                </RelativePanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" Text="Pacientes" />

        <RelativePanel
            x:Name="GridTitle"
            Grid.Row="1"
            Margin="15,30,0,10">
            <TextBlock
                x:Name="Paciente"
                Margin="0,30,40,0"
                FontWeight="Bold"
                Text="Paciente" />
            <TextBlock
                x:Name="Telefone"
                Margin="0,30,40,0"
                FontWeight="Bold"
                RelativePanel.RightOf="Paciente"
                Text="Telefone" />
            <TextBlock
                x:Name="DataConsulta"
                Margin="0,30,40,0"
                FontWeight="Bold"
                RelativePanel.RightOf="Telefone"
                Text="Data Consulta" />
            <TextBlock
                x:Name="Acoes"
                Margin="0,30,40,0"
                FontWeight="Bold"
                RelativePanel.RightOf="DataConsulta"
                Text="Ações" />
        </RelativePanel>

        <ListView
            Grid.Row="2"
            MinWidth="250"
            MinHeight="550"
            MaxWidth="1000"
            MaxHeight="250"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            IsItemClickEnabled="False"
            IsTapEnabled="False"
            ItemTemplate="{StaticResource PatientsDataTemplate}"
            ItemsPanel="{StaticResource PanelItensTemplate}"
            ItemsSource="{x:Bind ViewModel.Patients}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled" />
    </Grid>
</Page>